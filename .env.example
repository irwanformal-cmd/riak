# Riak — environment configuration (optional)
# Copy to .env and fill in to enable LLM-powered enhancement.
#
# Without any keys the app runs fully offline using its built-in
# deterministic rule-based engine. With a key, it adds richer entity
# extraction, in-character agent dialogue, and editorial report summaries.
#
# TIP: you can also configure the provider from the web UI (⚙ in the top bar),
# which is saved to data/llm_config.json and takes priority over these vars.

# Any OpenAI-compatible API endpoint works (OpenAI, DeepSeek, Qwen/DashScope,
# Ollama, vLLM, LM Studio, ...).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Server
RIAK_HOST=127.0.0.1
RIAK_PORT=8000

# Rate limit per client IP (requests/minute, default 600)
RIAK_RATE_LIMIT=600

# Stricter limit for compute-heavy endpoints that spend LLM quota
# (build/simulate/develop/compare/report/chat/derive; default 30/min)
RIAK_RATE_LIMIT_HEAVY=30

# Access token — REQUIRED when RIAK_HOST is not 127.0.0.1!
# When set, every /api/* call must send:  Authorization: Bearer <token>
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RIAK_TOKEN=

# Concurrent LLM calls during web expansion and A/B compare (default 4).
# Higher = faster on providers that parallelize well; set to 1 if your
# provider rate-limits or serializes requests.
RIAK_LLM_WORKERS=4

# Log level: DEBUG, INFO, WARNING, ERROR (default INFO)
# Logs go to stderr and a rotating server.log next to server.py
RIAK_LOG_LEVEL=INFO
