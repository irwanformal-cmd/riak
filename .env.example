# Wanion — environment configuration (optional)
# Copy to .env and fill in to enable LLM-powered enhancement.
#
# Without any keys the app runs fully offline using its built-in
# deterministic rule-based engine. With a key, it adds richer entity
# extraction, in-character agent dialogue, and editorial report summaries.
#
# TIP: you can also configure the provider from the web UI (⚙ in the top bar),
# which is saved to data/llm_config.json and takes priority over these vars.

# Any OpenAI-compatible API endpoint works (OpenAI, DeepSeek, Qwen/DashScope,
# Ollama, vLLM, LM Studio, ...).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Server
MIROFISH_HOST=127.0.0.1
MIROFISH_PORT=8000
